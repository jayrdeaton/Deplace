{
  "name": "deplace",
  "version": "2.0.0",
  "description": "Save and jump to directory shortcuts in your terminal",
  "keywords": [
    "bookmark",
    "cd",
    "cli",
    "cross-platform",
    "directory",
    "jump",
    "launcher",
    "navigation",
    "shortcut",
    "terminal",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrdeaton/deplace.git"
  },
  "license": "ISC",
  "author": "Jay Deaton",
  "sideEffects": true,
  "type": "commonjs",
  "exports": {
    ".": "./dist/cli.js"
  },
  "main": "dist/cli.js",
  "bin": {
    "deplace": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:patch": "npm version patch && git push --follow-tags",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "preversion": "npm run lint && npm test && npm run build"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "termkit": "^2.4.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-package-json": "^1.6.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
